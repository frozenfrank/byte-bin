lcProcFiltNoAmbiguousCodes() ;
	q "NoAmbiguous"
	;---------
	; SCOPE:        PRIVATE
	; DESCRIPTION:  Role filter option: lines with no role at all
	; REVISIONS:
	;  *DNL 01/26 2268290 - Created
